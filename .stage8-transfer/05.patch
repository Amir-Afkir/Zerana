+      this.bundle.collider, this.bundle.packet.positions, this.bundle.packet.indices);
+  }
+  advance(deadline) {
+    const start = performance.now(), stage = this.stage;
+    try {
+      if (this.cancelled) return false;
+      if (this.error) throw this.error;
+      if (stage === 'validate') {
+        if (this.validator) {
+          let result;
